-- Panthraa fresh Supabase reset schema.
-- WARNING: This deletes Panthraa app tables and recreates them from scratch.
-- Use this only on a new/empty Supabase project, or after backing up real data.
-- Keep this file in sync with every backend/RPC/table change used by the app.
-- If the app calls a new Supabase RPC, add it here so a fresh reset still works.

create extension if not exists pgcrypto with schema extensions;

do $$
declare
    app_function record;
begin
    for app_function in
        select
            n.nspname as schema_name,
            p.proname as function_name,
            pg_get_function_identity_arguments(p.oid) as function_args
        from pg_proc p
        join pg_namespace n on n.oid = p.pronamespace
        where n.nspname = 'public'
          and p.proname in (
              'approve_class_join_request',
              'create_announcement',
              'create_class',
              'create_class_assignment',
              'create_professor_class',
              'delete_class_assignment',
              'delete_announcement',
              'delete_professor_subject',
              'get_app_users_public',
              'get_assignment_attendance',
              'get_class_assignments',
              'get_assignment_submissions',
              'grade_assignment_submission',
              'get_class_join_requests',
              'get_classmates',
              'get_latest_assignment_status',
              'get_professor_announcements',
              'get_professor_class_students',
              'get_professor_classes',
              'get_student_announcements',
              'get_student_classes',
              'get_student_grades',
              'get_student_pending_assignments',
              'join_class_by_code',
              'login_app_user',
              'normalize_year_level',
              'professor_class_json',
              'register_app_user',
              'reject_class_join_request',
              'record_assignment_attendance_by_id_number',
              'record_material_view',
              'request_password_reset_code',
              'verify_password_reset_code',
              'submit_assignment',
              'toggle_announcement_read_status',
              'update_announcement',
              'update_app_user_extended_profile',
              'update_app_user_profile_picture',
              'update_class_assignment',
              'year_label'
          )
    loop
        execute format(
            'drop function if exists %I.%I(%s) cascade',
            app_function.schema_name,
            app_function.function_name,
            app_function.function_args
        );
    end loop;
end $$;

drop function if exists public.get_app_users_public();
drop function if exists public.register_app_user(text, text, text, text);
drop function if exists public.login_app_user(text, text, text);
drop function if exists public.update_app_user_profile_picture(uuid, text);
drop function if exists public.update_app_user_extended_profile(uuid, text, text, text, text, text, text, text);
drop function if exists public.update_app_user_extended_profile(uuid, text, text, text, text, text, text, text, text);
drop function if exists public.create_professor_class(uuid, text);
drop function if exists public.create_class(uuid, text, text, text, text, text, text);
drop function if exists public.create_class(uuid, text, text, text, text, text, text, text, text, text);
drop function if exists public.get_professor_classes(uuid);
drop function if exists public.get_student_classes(uuid);
drop function if exists public.join_class_by_code(uuid, text);
drop function if exists public.get_class_attendance(uuid, uuid, date);
drop function if exists public.record_attendance_by_id_number(uuid, uuid, text, date);
drop function if exists public.get_assignment_attendance(uuid, uuid);
drop function if exists public.record_assignment_attendance_by_id_number(uuid, uuid, text);
drop function if exists public.record_material_view(uuid, uuid);
drop function if exists public.get_class_join_requests(uuid, uuid);
drop function if exists public.approve_class_join_request(uuid, uuid);
drop function if exists public.reject_class_join_request(uuid, uuid);
drop function if exists public.get_classmates(uuid);
drop function if exists public.create_class_assignment(uuid, uuid, text, text);
drop function if exists public.create_class_assignment(uuid, uuid, text, text, text, int);
drop function if exists public.create_class_assignment(uuid, uuid, text, text, text, numeric);
drop function if exists public.create_class_assignment(uuid, uuid, text, text, text, numeric, date, date, time, time);
drop function if exists public.create_class_assignment(uuid, uuid, text, text, text, numeric, date, date, time, time, text, text);
drop function if exists public.get_class_assignments(uuid, uuid);
drop function if exists public.get_assignment_submissions(uuid, uuid);
drop function if exists public.grade_assignment_submission(uuid, uuid, int);
drop function if exists public.submit_assignment(uuid, uuid, text);
drop function if exists public.submit_assignment(uuid, uuid, text, text);
drop function if exists public.delete_class_assignment(uuid, uuid);
drop function if exists public.delete_professor_subject(uuid, text, text);
drop function if exists public.delete_professor_subject(uuid, text, text, text, text, text);
drop function if exists public.get_latest_assignment_status(uuid);
drop function if exists public.get_professor_class_students(uuid);
drop function if exists public.create_announcement(uuid, text, text, text, jsonb);
drop function if exists public.get_student_announcements(uuid);
drop function if exists public.get_student_grades(uuid);
drop function if exists public.get_student_pending_assignments(uuid);
drop function if exists public.get_professor_announcements(uuid);
drop function if exists public.toggle_announcement_read_status(uuid, uuid, boolean);
drop function if exists public.update_announcement(uuid, uuid, text, text, text, jsonb);
drop function if exists public.delete_announcement(uuid, uuid);
drop function if exists public.normalize_year_level(text);
drop function if exists public.year_label(text);

drop table if exists public.announcement_reads cascade;
drop table if exists public.class_announcements cascade;
drop table if exists public.attendance cascade;
drop table if exists public.assignment_submissions cascade;
drop table if exists public.class_assignments cascade;
drop table if exists public.class_join_requests cascade;
drop table if exists public.class_enrollments cascade;
drop table if exists public.classes cascade;
drop table if exists public.password_reset_codes cascade;
drop table if exists public.app_users cascade;

create table public.app_users (
    id uuid primary key default extensions.gen_random_uuid(),
    id_number text not null unique,
    password text not null,
    full_name text not null,
    email text not null default '',
    role text not null check (role in ('student', 'professor')),
    profile_picture_url text,
    course text,
    year_level text check (year_level is null or year_level in ('first', 'second', 'third', 'fourth')),
    section text,
    track text,
    bio text,
    phone_number text,
    is_blocked boolean not null default false,
    created_at timestamptz not null default now()
);

-- One phone number per account; blank/null phones are never treated as duplicates.
create unique index if not exists app_users_phone_number_key
    on public.app_users (phone_number)
    where phone_number is not null and trim(phone_number) <> '';

-- Issued password-reset codes (OTP). One active, unconsumed code per user.
create table public.password_reset_codes (
    id uuid primary key default extensions.gen_random_uuid(),
    user_id uuid not null references public.app_users(id) on delete cascade,
    code_hash text not null,
    expires_at timestamptz not null,
    tries_left integer not null default 3,
    consumed_at timestamptz,
    created_at timestamptz not null default now()
);

create index password_reset_codes_user_idx
    on public.password_reset_codes (user_id);

create table public.classes (
    id uuid primary key default extensions.gen_random_uuid(),
    professor_id uuid not null references public.app_users(id) on delete cascade,
    class_code text,
    subject_name text,
    class_name text not null,
    subject_code text not null,
    join_code text not null unique check (join_code ~ '^[0-9]{6}$'),
    year_level text check (year_level is null or year_level in ('first', 'second', 'third', 'fourth')),
    department text not null default 'Unassigned',
    section text not null default 'Unassigned',
    track text,
    schedule_days text[] not null default array[]::text[],
    schedule_start_time time,
    schedule_end_time time,
    cover_image_url text,
    theme_color text not null default 'blue',
    created_at timestamptz not null default now(),
    constraint classes_schedule_days_check check (
        schedule_days <@ array['monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday']::text[]
    ),
    constraint classes_schedule_time_check check (
        (array_length(schedule_days, 1) is null and schedule_start_time is null and schedule_end_time is null)
        or (array_length(schedule_days, 1) > 0 and schedule_start_time is not null and schedule_end_time is not null and schedule_start_time < schedule_end_time)
    )
);

create table public.class_enrollments (
    class_id uuid not null references public.classes(id) on delete cascade,
    student_id uuid not null references public.app_users(id) on delete cascade,
    created_at timestamptz not null default now(),
    primary key (class_id, student_id)
);

create table public.class_join_requests (
    id uuid primary key default extensions.gen_random_uuid(),
    class_id uuid not null references public.classes(id) on delete cascade,
    student_id uuid not null references public.app_users(id) on delete cascade,
    status text not null default 'pending' check (status in ('pending', 'approved', 'rejected')),
    requested_at timestamptz not null default now(),
    decided_at timestamptz,
    decided_by uuid references public.app_users(id) on delete set null
);

create unique index class_join_requests_one_pending
on public.class_join_requests (class_id, student_id)
where status = 'pending';

create table public.class_assignments (
    id uuid primary key default extensions.gen_random_uuid(),
    class_id uuid not null references public.classes(id) on delete cascade,
    professor_id uuid not null references public.app_users(id) on delete cascade,
    title text not null,
    instructions text not null default '',
    category text not null default 'lecture' check (category in ('lecture', 'laboratory')),
    target_points numeric not null default 100 check (target_points > 0),
    start_date date,
    end_date date,
    start_time time without time zone,
    end_time time without time zone,
    created_at timestamptz not null default now(),
    assignment_type text not null default 'task' check (assignment_type in ('material', 'task', 'quiz', 'exam')),
    file_url text
);

create table public.assignment_submissions (
    id uuid primary key default extensions.gen_random_uuid(),
    assignment_id uuid not null references public.class_assignments(id) on delete cascade,
    student_id uuid not null references public.app_users(id) on delete cascade,
    response_text text not null,
    submitted_at timestamptz not null default now(),
    edit_attempts int not null default 0,
    score int check (score is null or score >= 0),
    submission_file_url text,
    unique (assignment_id, student_id)
);

create table public.attendance (
    id uuid primary key default extensions.gen_random_uuid(),
    assignment_id uuid not null references public.class_assignments(id) on delete cascade,
    class_id uuid not null references public.classes(id) on delete cascade,
    student_id uuid not null references public.app_users(id) on delete cascade,
    id_number text not null,
    attendance_date date not null default current_date,
    status text not null default 'present' check (status in ('present')),
    created_at timestamptz not null default now(),
    unique (assignment_id, student_id)
);

create table public.class_announcements (
    id uuid primary key default extensions.gen_random_uuid(),
    professor_id uuid not null references public.app_users(id) on delete cascade,
    target_years text[] not null default array[]::text[],
    title text not null,
    subtitle text not null default '',
    content text not null,
    image_url text,
    created_at timestamptz not null default now(),
    updated_at timestamptz,
    check (
        target_years <@ array['first', 'second', 'third', 'fourth']::text[]
    )
);

create table public.announcement_reads (
    announcement_id uuid not null references public.class_announcements(id) on delete cascade,
    student_id uuid not null references public.app_users(id) on delete cascade,
    is_read boolean not null default false,
    updated_at timestamptz not null default now(),
    primary key (announcement_id, student_id)
);

